# PayPal Sandbox Credentials (Orders v2 & Webhook)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here
PAYPAL_ENVIRONMENT=sandbox
PORT=3000

# ══════════════════════════════════════════════════════════════════════════
# Payvault Persistence & Cache Architecture
# ══════════════════════════════════════════════════════════════════════════

# PostgreSQL: Permanent Source of Truth (Payments, Orders, Settlements, Investigations)
# All monetary fields are strictly stored as integer paise (BIGINT).
POSTGRES_DB=payvault
POSTGRES_USER=payvault
# Required by docker-compose.yml (no default is committed). Any local-only value works.
POSTGRES_PASSWORD=change-me-local-dev
DATABASE_URL=postgresql://payvault:change-me-local-dev@localhost:5432/payvault

# Redis: Fast Transient State (Chat Conversation Context & Cache)
# Uses scoped keys: payvault:chat:<investigationId>:<conversationId>
REDIS_URL=redis://localhost:6379
CHAT_CONTEXT_TTL_SECONDS=3600

# Payvault Native Intelligence Thresholds
AI_DIFFICULTY_THRESHOLD=50
AI_PRIMARY_CONFIDENCE_THRESHOLD=0.75
